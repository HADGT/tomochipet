@model qlthucung.Models.DichVu
@{
    ViewData["Title"] = "Datlich";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Modal -->
<style>
    label {
        font-family: "r0c0i Linotte", sans-serif;
        font-style: normal;
        font-weight: 600;
        font-size: 16px;
        line-height: 30px;
        color: var(--mainColor);
        padding-bottom: 10px;
    }

    input, .form-label, .form-control:focus, .form-control {
        font-size: 16px;
    }

</style>
<div class="w-75 m-auto p-5">
    <h1 style="color: coral; text-align: center; top: 50%; left: 50%;">
        Đặt lịch hẹn
    </h1>

    <form method="POST" asp-controller="DichVu" asp-action="DatLich" class="container mt-4">
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            @if (ViewBag.KhachHangName != null)
            {
                <input type="hidden" name="Username" value="@ViewBag.Username" />
            }

            <div class="form-group">
                <label for="hoten" class="form-label pt-4 pb-0">Họ và Tên</label>
                @Html.EditorFor(model => model.Hoten, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Hoten, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="email" class="form-label pt-4 pb-0">Email</label>
                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="sdt" class="form-label pt-4 pb-0">Số Điện Thoại</label>
                @Html.EditorFor(model => model.Sdt, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Sdt, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="diachi" class="form-label pt-4 pb-0">Địa Chỉ</label>
                @Html.EditorFor(model => model.Diachi, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Diachi, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="loaidv" class="form-label pt-4 pb-0">Dịch Vụ</label>
                <select asp-for="Tendichvu" class="form-control"
                        asp-items="@(new SelectList(ViewBag.SPDV, "TenDichVu", "TenDichVu"))">
                    <option value="">-- Chọn dịch vụ --</option>
                </select>
                @Html.ValidationMessageFor(model => model.Tendichvu, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label for="ngaydat" class="form-label pt-4 pb-0">Ngày và Giờ Đặt</label>

                <div class="row">
                    <div class="col-md-6">
                        <input type="date" id="ngay" class="form-control" required min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6">
                        <input type="time" id="gio" class="form-control" required />
                    </div>
                </div>

                <!-- Field ẩn để lưu giá trị đầy đủ -->
                <input type="hidden" id="ngaydat" name="Ngaydat" />

                <small id="ngaydat-error" class="text-danger"></small>
                @Html.ValidationMessageFor(model => model.Ngaydat, "", new { @class = "text-danger" })
            </div>

            <div class="form-group text-center mt-3">
                <button type="submit" id="btnSubmit" class="btn btn-primary mb-2">Xác Nhận</button>
                <a asp-action="Index" asp-controller="DichVu" class="btn btn-primary">Quay lại</a>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ngayInput = document.getElementById("ngay");
        const gioInput = document.getElementById("gio");
        const ngaydatHidden = document.getElementById("ngaydat");
        const errorText = document.getElementById("ngaydat-error");
        const btnSubmit = document.getElementById("btnSubmit");

        function validateDateTime() {
            // Reset
            ngaydatHidden.value = "";
            btnSubmit.disabled = true;

            if (!ngayInput.value || !gioInput.value) {
                errorText.textContent = "⚠️ Vui lòng chọn ngày và giờ!";
                return;
            }

            const selectedDateTime = new Date(`${ngayInput.value}T${gioInput.value}`);
            const now = new Date();
            const hour = selectedDateTime.getHours();

            // === 1️⃣ Kiểm tra nếu ngày là hôm nay thì giờ không được nhỏ hơn hiện tại ===
            const selectedDate = new Date(ngayInput.value);
            const today = new Date();
            const sameDay =
                selectedDate.getFullYear() === today.getFullYear() &&
                selectedDate.getMonth() === today.getMonth() &&
                selectedDate.getDate() === today.getDate();

            if (sameDay) {
                if (
                    selectedDateTime.getHours() < now.getHours() ||
                    (selectedDateTime.getHours() === now.getHours() &&
                        selectedDateTime.getMinutes() <= now.getMinutes())
                ) {
                    errorText.textContent = "⚠️ Giờ đặt không được nhỏ hơn thời gian hiện tại!";
                    return;
                }
            } else if (selectedDateTime < now) {
                // Ngày trong quá khứ
                errorText.textContent = "⚠️ Ngày đặt không được nhỏ hơn ngày hiện tại!";
                return;
            }

            // === 2️⃣ Giới hạn 8h - 20h ===
            if (hour < 8 || hour >= 20) {
                errorText.textContent = "⚠️ Chỉ cho phép đặt lịch từ 8h sáng đến 8h tối!";
                return;
            }

            // === 3️⃣ Cấm giờ nghỉ trưa ===
            if (hour >= 12 && hour < 13) {
                errorText.textContent = "⚠️ Không thể đặt lịch trong giờ nghỉ trưa (12h - 13h)!";
                return;
            }

            // === 4️⃣ Hợp lệ → Gộp vào field ẩn và enable nút ===
            ngaydatHidden.value = `${ngayInput.value}T${gioInput.value}`;
            errorText.textContent = "";
            btnSubmit.disabled = false;
        }

        ngayInput.addEventListener("change", validateDateTime);
        gioInput.addEventListener("change", validateDateTime);

        // Chạy validate 1 lần khi load trang
        validateDateTime();
    });
</script>

<!-- SweetAlert hiển thị lỗi ModelState -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (!ViewData.ModelState.IsValid)
{
    foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi!',
                text: '@error.ErrorMessage',
                confirmButtonColor: '#ff7f50'
            });
        </script>
    }
}
@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Thành công!',
            text: '@TempData["Success"]',
            confirmButtonColor: '#ff7f50'
        });
    </script>
}