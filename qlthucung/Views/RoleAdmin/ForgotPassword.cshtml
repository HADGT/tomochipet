@model qlthucung.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/cssSecurity/style.css" rel="stylesheet" />
<link href="~/Content/cssSecurity/style1.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: "Inter", "Segoe UI", sans-serif;
        font-size: 15px;
    }

    .header, footer, .go-to-top {
        display: none;
    }

    .forgot-container {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        padding: 2.2rem 2rem;
        width: 100%;
        max-width: 380px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .forgot-container:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

    .forgot-title {
        font-weight: 700;
        color: #222;
        font-size: 1.3rem;
        text-align: center;
        margin-bottom: 1.2rem;
    }

    .form-label {
        font-weight: 500;
        color: #444;
        font-size: 0.9rem;
    }

    .form-control {
        border-radius: 8px;
        padding: 9px 11px;
        font-size: 0.9rem;
        border: 1px solid #ccc;
        transition: all 0.25s ease;
    }

        .form-control:focus {
            border-color: #a29bfe;
            box-shadow: 0 0 5px rgba(162, 155, 254, 0.4);
        }

    .btn-submit {
        background: linear-gradient(135deg, #a29bfe 0%, #81ecec 100%);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        width: 100%;
        padding: 10px 0;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            background: linear-gradient(135deg, #6c5ce7 0%, #00cec9 100%);
            transform: translateY(-2px);
        }

    .back-link {
        display: inline-block;
        margin-top: 1rem;
        text-decoration: none;
        color: #0984e3;
        font-weight: 500;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }

        .back-link:hover {
            color: #0056b3;
            text-decoration: underline;
        }

    .alert-danger {
        font-size: 0.85rem;
        padding: 0.75rem;
        border-radius: 8px;
    }
</style>

<div class="forgot-container">
    <form asp-action="ForgotPassword" asp-controller="RoleAdmin" method="post" id="form-forgot">
        @Html.AntiForgeryToken()

        <h3 class="forgot-title">🔒 Quên mật khẩu</h3>

        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        }

        <div class="form-group mb-3">
            <label asp-for="UserName" class="form-label">Tên tài khoản</label>
            <input asp-for="UserName" class="form-control" placeholder="Nhập tên tài khoản" required />
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label">Email đăng ký</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email đăng ký" required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn-submit mt-2">Gửi yêu cầu đặt lại</button>

        <div class="text-center">
            <a asp-controller="Security" asp-action="SignIn" class="back-link">← Quay lại đăng nhập</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
