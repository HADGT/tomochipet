@{
    ViewData["Title"] = "Quên mật khẩu - Xác nhận";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/cssSecurity/style.css" rel="stylesheet" />
<link href="~/Content/cssSecurity/style1.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: "Inter", "Segoe UI", sans-serif;
        font-size: 15px;
    }

    .header, footer, .go-to-top {
        display: none;
    }

    .confirm-container {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        padding: 2.2rem 2rem;
        width: 100%;
        max-width: 420px;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .confirm-container:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

    .confirm-title {
        font-weight: 700;
        color: #27ae60;
        font-size: 1.4rem;
        margin-bottom: 1rem;
    }

    .confirm-text {
        color: #444;
        font-size: 0.95rem;
        margin-bottom: 0.8rem;
        line-height: 1.5;
    }

    .confirm-note {
        color: #777;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .btn-back {
        background: linear-gradient(135deg, #a29bfe 0%, #81ecec 100%);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        width: 100%;
        max-width: 260px;
        height: 44px; /* đảm bảo chiều cao cố định */
        line-height: 44px; /* căn chữ giữa theo chiều dọc */
        font-size: 0.95rem;
        margin-top: 1.2rem;
        transition: all 0.3s ease;
        display: inline-block;
        text-decoration: none;
        text-align: center;
    }

        .btn-back:hover {
            background: linear-gradient(135deg, #6c5ce7 0%, #00cec9 100%);
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }
</style>


<div class="confirm-container">
    <h3 class="confirm-title">✅ Yêu cầu đặt lại mật khẩu đã được gửi</h3>

    <p class="confirm-text">
        Nếu địa chỉ email bạn cung cấp tồn tại trong hệ thống, chúng tôi đã gửi cho bạn
        một email chứa hướng dẫn đặt lại mật khẩu.
    </p>

    <p class="confirm-note">
        Vui lòng kiểm tra hộp thư đến hoặc thư mục <strong>Spam/Junk</strong>.
    </p>

    <a asp-controller="Security" asp-action="SignIn" class="btn-back">← Quay lại đăng nhập</a>
</div>
