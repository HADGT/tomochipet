@{
    ViewData["Title"] = "Thống kê - Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .stats-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin: 30px 0;
    }

    .stat-card {
        flex: 1 1 220px;
        background: linear-gradient(135deg, #a67c52, #6f4e37);
        color: #fff;
        border-radius: 15px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: transform 0.2s ease-in-out;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card h3 {
            font-size: 1.8rem;
            margin: 10px 0;
            font-weight: 700;
        }

        .stat-card h4 {
            font-size: 1rem;
            font-weight: 500;
            color: #f0e5da;
        }

    #chart-container {
        max-width: 900px;
        margin: 40px auto;
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }
</style>

<div class="stats-container">
    <div class="stat-card" style="background: #6f4e37;">
        <h3>@String.Format("{0:N0}", ViewBag.TongDoanhThu) VND</h3>
        <h4>Tổng doanh thu</h4>
    </div>
    <div class="stat-card" style="background: #a67c52;">
        <h3>@ViewBag.ThongKeDonHang đơn</h3>
        <h4>Tổng đơn hàng</h4>
    </div>
    <div class="stat-card" style="background: #8b5e3c;">
        <h3>@ViewBag.ThongKeKH người</h3>
        <h4>Số lượng thành viên</h4>
    </div>
    <div class="stat-card" style="background: #d9c3a9; color: #000;">
        <h3>@ViewBag.ThongKeSL</h3>
        <h4>Số lượng sản phẩm</h4>
    </div>
</div>

<div id="chart-container">
    <canvas id="revenueChart" width="800" height="400"></canvas>
</div>

<div id="chart-container" style="margin-top: 40px;">
    <canvas id="productChart" width="800" height="400"></canvas>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    $(document).ready(function () {
        // Biểu đồ doanh thu
        $.ajax({
            url: '/Admin/DoanhThu',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (!data) return;

                const ctx = document.getElementById('revenueChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Hôm nay', 'Tuần này', 'Tháng này'],
                        datasets: [{
                            label: 'Doanh thu (VND)',
                            data: [data.revenueToday || 0, data.revenueWeek || 0, data.revenueMonth || 0],
                            backgroundColor: ['#c19a6b', '#a67c52', '#6f4e37'],
                            borderColor: ['#9b7b5b', '#876142', '#5b3e2d'],
                            borderWidth: 1,
                            borderRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return context.raw.toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        return value.toLocaleString('vi-VN') + ' ₫';
                                    }
                                }
                            }
                        }
                    }
                });
            },
            error: function (err) {
                console.error("Lỗi Ajax Doanh Thu:", err);
            }
        });

        // Biểu đồ số lượng sản phẩm theo loại
        $.ajax({
            url: '/Admin/ThongKeSP',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                if (!data || !data.labels || !data.values) return;

                const ctx2 = document.getElementById('productChart').getContext('2d');
                new Chart(ctx2, {
                    type: 'pie',
                    data: {
                        labels: data.labels,
                        datasets: [{
                            label: 'Sản phẩm theo loại',
                            data: data.values,
                            backgroundColor: [
                                '#6f4e37', '#a67c52', '#c19a6b', '#d9c3a9', '#8b5e3c', '#b78e6d'
                            ],
                            borderColor: '#fff',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    font: { size: 14 }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return context.label + ': ' + context.raw + ' sản phẩm';
                                    }
                                }
                            }
                        }
                    }
                });
            },
            error: function (err) {
                console.error("Lỗi Ajax Thống kê SP:", err);
            }
        });
    });
</script>

