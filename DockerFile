# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# copy solution and project first for better cache
COPY *.sln ./
COPY qlthucung/*.csproj ./qlthucung/
RUN dotnet restore

COPY . .
RUN dotnet publish qlthucung -c Release -o /app

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# If you mount credentials.json at runtime keep this; otherwise code expects GOOGLE_CREDENTIALS_JSON env.
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

COPY --from=build /app ./

ENTRYPOINT ["dotnet", "qlthucung.dll"]